# Copy to .env, then run: node --env-file=.env src/api/server.mjs
# Never commit .env. Every key is optional — the demo runs with none of them.

PORT=3000

# 1 = never touch the network; every fetch reads cache/ then demo_fixtures/.
OFFLINE=0

# NASA Earthdata Login (Earthdata Search / CMR downloads). https://urs.earthdata.nasa.gov
EDL_USER=
# NASA FIRMS active-fire API map key (Bangladesh fire context). https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# api.nasa.gov key (higher rate limits than DEMO_KEY). https://api.nasa.gov
NASA_API_KEY=
# NASA ADS (Astrophysics Data System) token, for literature lookups. https://ui.adsabs.harvard.edu/user/settings/token
ADS_API_TOKEN=

# Optional: constrained AI evidence selection (src/agents/evidence-selector.mjs).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
