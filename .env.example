# VESTA AI keys. All optional. VESTA uses the first engine that works:
# Claude -> ChatGPT -> FreeLLMAPI -> OpenRouter -> Groq -> Gemini -> Offline mode.

# 1. Claude (paid, best quality) - console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 2. ChatGPT (paid) - platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=

# 3. FreeLLMAPI (free, LOCAL ONLY) - the FreeLLMAPI desktop app on this same PC.
#    Key: the unified API key from the app's Keys page. Never add these to Vercel.
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=
# Leave empty for the desktop app's default address (http://127.0.0.1:31415/v1)
FREELLMAPI_BASE_URL=
# "off" stops the Engine room reading FreeLLMAPI's monthly budget through its local dashboard sign-in
FREELLMAPI_BUDGET=

# 4. OpenRouter (free) - openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# 5. Groq (free) - console.groq.com
GROQ_API_KEY=
GROQ_MODEL=

# 6. Gemini (free) - aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=
